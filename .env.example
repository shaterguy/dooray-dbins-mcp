# Required 64-character URL-safe path secret
MCP_PATH_TOKEN=

# Optional compatibility access key for Bearer or X-MCP-Access-Key clients
MCP_ACCESS_KEY=

# Optional additional allowed Origin values, comma separated
MCP_ALLOWED_ORIGINS=

# Shared Dooray account credentials for both CalDAV Basic auth and LDAP bind
DOORAY_USERNAME=
DOORAY_PASSWORD=

# Separate Dooray REST API token
DOORAY_API_TOKEN=

# Optional Dooray REST settings
DOORAY_BASE_URL=https://api.dooray.com
DOORAY_ALLOWED_HOSTS=
DOORAY_TIMEOUT_MS=20000
DOORAY_MAX_RESPONSE_BYTES=2000000
DOORAY_MAX_TOOL_TEXT_CHARS=120000

